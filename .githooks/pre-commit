#!/usr/bin/env sh

. "$(dirname "$0")/_lib.sh"

if has_staged_changes frontend; then
  log_pending "running frontend pre-commit checks"
  make check-frontend
  make typecheck-frontend
fi

if has_staged_changes backend; then
  log_pending "running backend pre-commit checks"
  make check-backend
  make typecheck-backend
fi

log_success "pre-commit hook completed"
