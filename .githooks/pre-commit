#!/usr/bin/env sh

. "$(dirname "$0")/_lib.sh"

if has_staged_changes frontend; then
  log_pending "[frontend] running lint + format checks"
  make check-frontend
  log_pending "[frontend] running type checks"
  make typecheck-frontend
fi

if has_staged_changes backend; then
  log_pending "[backend] running lint + format checks"
  make check-backend
  log_pending "[backend] running type checks"
  make typecheck-backend
fi

log_success "pre-commit hook completed"
